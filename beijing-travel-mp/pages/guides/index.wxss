.page-heading { font-size:44rpx; font-weight:700; margin:20rpx 0 26rpx; }.page-heading text { display:block; color:var(--muted); font-size:23rpx; font-weight:400; line-height:1.65; margin-top:10rpx; }

/* 路线规划入口卡片 - 突出样式 */
.itinerary-entry { display:flex; align-items:center; width:100%; padding:28rpx 24rpx; margin-bottom:24rpx; background: linear-gradient(135deg, #1F5B4F 0%, #2d7a6a 100%); border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(31, 91, 79, 0.25); }
.itinerary-entry .entry-icon { width:80rpx; height:80rpx; flex:none; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.15); border-radius:20rpx; font-size:40rpx; }
.itinerary-entry .entry-content { flex:1; min-width:0; margin-left:20rpx; }
.itinerary-entry .entry-title { font-size:32rpx; font-weight:700; color:#fff; }
.itinerary-entry .entry-desc { color:rgba(255,255,255,0.85); font-size:24rpx; margin-top:8rpx; }
.itinerary-entry .entry-tags { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:12rpx; }
.itinerary-entry .tag { display:inline-block; padding:4rpx 12rpx; background:rgba(255,255,255,0.2); border-radius:10rpx; font-size:20rpx; color:#fff; }
.itinerary-entry .arrow { flex:none; color:#fff; font-size:42rpx; }

/* 分割线标题 */
.section-title { font-size:28rpx; font-weight:600; color:var(--text); margin:32rpx 0 16rpx; padding-left:8rpx; border-left:4rpx solid var(--vermilion); }

.guide-list { margin-top:16rpx; }.guide { display:flex; align-items:center; width:100%; padding:24rpx; margin-bottom:18rpx; }.icon { width:72rpx; height:72rpx; flex:none; display:flex; align-items:center; justify-content:center; background:var(--soft-green); border-radius:18rpx; font-size:38rpx; }.content { flex:1; min-width:0; margin-left:20rpx; }.title { font-size:30rpx; font-weight:700; }.summary { color:var(--muted); font-size:23rpx; margin-top:8rpx; }.arrow { flex:none; color:var(--vermilion); font-size:42rpx; }
