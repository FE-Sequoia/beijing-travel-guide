<view class="page safe-bottom"><view class="page-heading">探索北京<text>从熟悉的地标，到胡同深处的惊喜</text></view><view class="search-box"><view class="search-icon"></view><input value="{{keyword}}" placeholder="搜索景点、攻略、美食或路线" bindinput="onInput" /></view><scroll-view scroll-x class="filters"><text class="filter {{active === '' ? 'selected' : ''}}" data-id="" bindtap="onCategory">全部</text><text wx:for="{{categories}}" wx:key="id" class="filter {{active === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onCategory">{{item.name}}</text></scroll-view><view wx:if="{{!keyword}}" class="result-bar"><text>共 {{places.length}} 处</text><picker range="{{sortOptions}}" bindchange="onSort"><view class="sort">{{sort === 'name' ? '按名称' : '优先推荐'}}</view></picker></view><view class="list"><place-card wx:for="{{places}}" wx:key="id" place="{{item}}" variant="compact" bind:tap="onPlace"></place-card></view><view wx:if="{{search.guides.length}}" class="search-section"><view class="section-title">攻略</view><view wx:for="{{search.guides}}" wx:key="id" class="search-item" data-id="{{item.id}}" bindtap="onGuide"><text class="item-icon">{{item.icon}}</text><view class="item-body"><view class="item-name">{{item.title}}</view><view class="item-summary">{{item.summary}}</view></view><text class="arrow">›</text></view></view><view wx:if="{{search.foods.length}}" class="search-section"><view class="section-title">美食</view><view wx:for="{{search.foods}}" wx:key="id" class="search-item" data-id="{{item.id}}" bindtap="onFood"><text class="item-icon">🥢</text><view class="item-body"><view class="item-name">{{item.name}}</view><view class="item-summary">{{item.summary}}</view></view><text class="arrow">›</text></view></view><view wx:if="{{search.itineraries.length}}" class="search-section"><view class="section-title">行程</view><view wx:for="{{search.itineraries}}" wx:key="id" class="search-item" data-days="{{item.days}}" bindtap="onItinerary"><text class="item-icon">🗺️</text><view class="item-body"><view class="item-name">{{item.days}}日游 · {{item.title}}</view><view class="item-summary">{{item.placeNames.join(' → ')}}</view></view><text class="arrow">›</text></view></view><empty-state wx:if="{{!places.length && !search.guides.length && !search.foods.length && !search.itineraries.length}}" title="还没有找到" description="换个关键词，或看看全部分类" button-text="清除筛选" bind:actiontap="clear"></empty-state></view>
