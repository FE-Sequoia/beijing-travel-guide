.detail { padding-top:54rpx; }
.guide-header { padding:0 6rpx; }
.icon { font-size:70rpx; }
.title { font-size:52rpx; font-weight:700; margin-top:16rpx; }
.summary { color:var(--muted); font-size:28rpx; line-height:1.7; margin-top:14rpx; }
.content-card { margin-top:32rpx; padding:32rpx 30rpx 8rpx; background:var(--surface); border:1rpx solid rgba(38,50,56,.06); border-radius:24rpx; box-shadow:0 10rpx 28rpx rgba(53,72,65,.045); }
.section { margin-top:24rpx; }
.section:first-child { margin-top:0; }
.section-title { font-size:34rpx; font-weight:700; margin-bottom:10rpx; }
.copy { color:#48524E; font-size:27rpx; line-height:1.6; margin-bottom:10rpx; white-space:pre-line; }
.copy:last-child { margin-bottom:0; }
