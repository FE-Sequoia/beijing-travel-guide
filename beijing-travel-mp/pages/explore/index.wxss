.page-heading { font-size:44rpx; font-weight:700; margin:20rpx 0 26rpx; }.page-heading text { display:block; color:var(--muted); font-size:23rpx; font-weight:400; line-height:1.65; margin-top:10rpx; }.search-box { display:flex; align-items:center; min-width:0; height:104rpx; background:rgba(255,252,247,.78); border:1rpx solid rgba(38,50,56,.05); border-radius:16rpx; padding:0 26rpx; color:var(--ink-green); }.search-icon { position:relative; width:32rpx; height:32rpx; flex:none; border:4rpx solid var(--ink-green); border-radius:50%; }.search-icon::after { content:''; position:absolute; width:14rpx; height:4rpx; right:-10rpx; bottom:-5rpx; background:var(--ink-green); border-radius:999rpx; transform:rotate(45deg); transform-origin:left center; }.search-box input { flex:1; min-width:0; height:100%; padding:0 0 0 24rpx; font-size:28rpx; line-height:104rpx; }.filters { width:100%; white-space:nowrap; margin:26rpx 0 18rpx; }.filter { display:inline-block; padding:13rpx 22rpx; background:rgba(228,239,233,.72); color:var(--muted); border-radius:30rpx; margin-right:12rpx; font-size:23rpx; }.filter.selected { color:#FFF; background:var(--ink-green); }.result-bar { display:flex; min-width:0; justify-content:space-between; align-items:center; color:var(--muted); font-size:22rpx; margin-bottom:18rpx; }.sort { display:inline-flex; align-items:center; gap:8rpx; color:var(--ink-green); background:rgba(228,239,233,.72); border-radius:20rpx; padding:9rpx 16rpx; }.sort::after { content:''; width:12rpx; height:12rpx; border-right:3rpx solid var(--ink-green); border-bottom:3rpx solid var(--ink-green); transform:rotate(45deg) translateY(-3rpx); }.list { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:18rpx; } .list place-card { display:block; width:100%; }
.search-section { margin-top:30rpx; }
.search-section .section-title { font-size:28rpx; font-weight:600; color:var(--ink); margin-bottom:14rpx; padding-left:8rpx; border-left:4rpx solid var(--vermilion); }
.search-item { display:flex; align-items:center; width:100%; padding:22rpx 24rpx; margin-bottom:16rpx; background:var(--surface); border:1rpx solid rgba(38,50,56,.06); border-radius:18rpx; }
.item-icon { flex:none; font-size:38rpx; }
.item-body { flex:1; min-width:0; margin-left:20rpx; }
.item-name { font-size:29rpx; font-weight:700; }
.item-summary { color:var(--muted); font-size:23rpx; line-height:1.6; margin-top:6rpx; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.arrow { flex:none; color:var(--vermilion); font-size:40rpx; }
