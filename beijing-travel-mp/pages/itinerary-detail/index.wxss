.hero { padding:34rpx 30rpx; border-radius:24rpx; color:#FFF; background:linear-gradient(135deg,var(--ink-green),#397565); }
.hero .eyebrow { color:#FFF; opacity:.78; font-size:22rpx; }
.title { font-size:44rpx; font-weight:700; margin-top:14rpx; }
.summary { font-size:24rpx; line-height:1.65; margin-top:12rpx; opacity:.92; }
.tip { margin-top:20rpx; padding:20rpx; border-radius:14rpx; background:#F6EEE4; color:#6D5845; font-size:23rpx; line-height:1.65; }
.day { margin-top:34rpx; }
.day-title { font-size:31rpx; font-weight:700; margin-bottom:15rpx; }
.stops { display:flex; flex-direction:column; gap:20rpx; }
.stop { overflow:hidden; background:#FFFCF7; border:1rpx solid #E6DED2; border-radius:16rpx; }
.stop-image { width:100%; height:auto; display:block; background:#f0f0f0; }
.stop-content { padding:20rpx; }
.time { display:inline-block; color:#B9513A; font-size:22rpx; font-weight:700; margin-bottom:10rpx; }
.place { font-size:30rpx; font-weight:700; }
.note { color:var(--muted); font-size:22rpx; line-height:1.55; margin-top:8rpx; }
